# Secret key used to sign JWT access tokens.
# Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Copy this file to `.env` (same folder) and set the value.
SECRET_KEY=change-me-to-a-long-random-string

# MongoDB connection string (async driver Motor). Required in production.
# Do NOT commit real credentials — put the real URI in `.env` (gitignored).
# For a local install this is typically:
#   mongodb://127.0.0.1:27017
# For MongoDB Atlas use the SRV connection string, e.g.:
#   mongodb+srv://<user>:<password>@ayurdietpro.prtmjcy.mongodb.net/?appName=AyurDietPro
MONGODB_URI=mongodb://127.0.0.1:27017

# Optional: name of the MongoDB database to use (defaults to "ayurdiet").
MONGODB_DB=AyurDietPro